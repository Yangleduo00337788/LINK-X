# 后端 API 地址（含 context-path /api）
VITE_API_BASE_URL=http://localhost:8080/api

# IM WebSocket 地址（Netty 独立端口）
VITE_WS_BASE_URL=ws://localhost:8081

# 可选：生产环境 MinIO/媒体公网 Origin（写入 Electron CSP img-src/media-src）
# VITE_MINIO_PUBLIC_ORIGIN=https://media.example.com

# 可选：WebRTC ICE（含 TURN）。JSON 数组；未配置时仅用公共 STUN（公司网/对称 NAT 可能连不上）
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]
