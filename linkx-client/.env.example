# 后端 API 地址（含 context-path /api）
VITE_API_BASE_URL=http://localhost:8080/api

# IM WebSocket 地址（Netty 独立端口）
VITE_WS_BASE_URL=ws://localhost:8081

# 可选：媒体公网 Origin（写入 Electron CSP img-src/media-src；MinIO/OSS 切换后按需配置）
# VITE_MINIO_PUBLIC_ORIGIN=https://minio-media.example.com
# VITE_OSS_PUBLIC_ORIGIN=https://your-bucket.oss-cn-hangzhou.aliyuncs.com
# VITE_COS_PUBLIC_ORIGIN=https://linkx-cos-1361202373.cos.ap-beijing.myqcloud.com
# 或统一别名（与上面二选一或同时配置）：
# VITE_MEDIA_PUBLIC_ORIGIN=https://media.example.com

# 官网根地址（默认 https://mars-studio.asia；法律页、帮助中心均在此域）
# VITE_LEGAL_PAGE_BASE_URL=https://mars-studio.asia
# VITE_HELP_PAGE_BASE_URL=https://mars-studio.asia/help

# 可选：WebRTC ICE（含 TURN）。JSON 数组；未配置时用国内可达公共 STUN（公司网/对称 NAT 仍建议配 TURN）
# VITE_ICE_SERVERS=[{"urls":"stun:stun.miwifi.com:3478"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]
