{
  "name": "linkx",
  "description": "LinkX — 企业级即时通讯与协同平台桌面客户端",
  "private": true,
  "version": "1.0.0",
  "author": "yangleduo",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron:dev": "node ./scripts/run-electron-dev.mjs",
    "installer:assets": "node ./scripts/generate-installer-assets.mjs",
    "electron:build": "node ./scripts/electron-build.mjs",
    "electron:build:win": "node ./scripts/electron-build.mjs",
    "electron:build:mac": "node ./scripts/electron-build-desktop.mjs mac",
    "electron:build:linux": "node ./scripts/electron-build-desktop.mjs linux",
    "installer:build": "node ./scripts/installer-build.mjs",
    "clean:release": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/clean-release.ps1",
    "installer:dev": "node ./scripts/run-installer-dev.mjs",
    "electron:preview": "electron dist-electron/main/main.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vicons/ionicons5": "^0.12.0",
    "axios": "^1.7.0",
    "highlight.js": "^11.12.0",
    "naive-ui": "^2.44.1",
    "pinia": "^2.3.1",
    "pinia-plugin-persistedstate": "^3.2.3",
    "sql.js": "^1.14.1",
    "vue": "^3.5.0",
    "vue-router": "^4.6.4",
    "vueuc": "^0.4.65"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/marked": "^5.0.2",
    "@vitejs/plugin-vue": "^5.0.4",
    "dompurify": "^3.4.11",
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3",
    "marked": "^18.0.5",
    "prettier": "^3.6.2",
    "rcedit": "^5.0.1",
    "sharp": "^0.33.5",
    "to-ico": "^1.1.5",
    "typescript": "^5.4.5",
    "unocss": "^0.59.4",
    "vite": "^5.4.12",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.0.11"
  },
  "build": {
    "appId": "com.linkx.app",
    "productName": "LinkX",
    "icon": "build/icon",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": "build",
        "filter": [
          "icon.ico",
          "icon.png",
          "icon-tray.png",
          "icon-*.png"
        ]
      }
    ],
    "win": {
      "target": "dir",
      "icon": "build/icon.ico",
      "sign": null,
      "signAndEditExecutable": false
    },
    "afterPack": "./scripts/after-pack.mjs",
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.social-networking"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Network"
    }
  }
}
