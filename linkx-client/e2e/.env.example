# 复制为 e2e/.env 或项目根 .env.e2e 后填写

# 后端 API（直连，不经 Vite 代理）
E2E_API_BASE_URL=http://127.0.0.1:8080

# 前端 dev server 地址
E2E_ADMIN_BASE_URL=http://127.0.0.1:5174
E2E_CLIENT_BASE_URL=http://127.0.0.1:5173

# 测试账号（管理端勿启用 TOTP；验证码建议在测试环境关闭）
E2E_ADMIN_USER=admin
E2E_ADMIN_PASSWORD=your-admin-password
E2E_CLIENT_USER=your-client-user
E2E_CLIENT_PASSWORD=your-client-password
