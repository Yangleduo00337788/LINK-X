# Electron 打包环境变量（复制为 .env.electron 后修改）
# 打包命令 npm run electron:build 使用 --mode electron，会读取本文件，不会加载 .env.production
#
# 本地联调后端（默认已提供 .env.electron）：
# VITE_API_BASE_URL=http://127.0.0.1:8080/api
# VITE_WS_BASE_URL=ws://127.0.0.1:8081

# 后端 API 地址（含 context-path /api）
VITE_API_BASE_URL=https://你的域名/api

# IM WebSocket 地址（Netty 独立端口）
VITE_WS_BASE_URL=wss://你的域名:8081

# 可选：生产环境 MinIO/媒体公网 Origin（写入 Electron CSP img-src/media-src）
# VITE_MINIO_PUBLIC_ORIGIN=https://media.你的域名

# 腾讯云 COS（预签名直链展示时必填，写入 Electron CSP）
# VITE_COS_PUBLIC_ORIGIN=https://your-bucket.cos.ap-beijing.myqcloud.com
# VITE_COS_REGION=ap-beijing
# VITE_COS_BUCKET_NAME=your-bucket-appid

# 官网（法律文档、帮助中心同域）
VITE_LEGAL_PAGE_BASE_URL=https://mars-studio.asia
VITE_HELP_PAGE_BASE_URL=https://mars-studio.asia/help

# 可选：WebRTC ICE（含 TURN）。JSON 数组
# VITE_ICE_SERVERS=[{"urls":"stun:stun.miwifi.com:3478"}]
