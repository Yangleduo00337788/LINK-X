# =============================================================================
# LinkX 后端 · 生产模板（.env.prod.example）
# -----------------------------------------------------------------------------
# 复制为 .env.prod 后填写；.env.prod 已 gitignore
# =============================================================================


# ---------- Profile / 端口 ----------
# 选择加载 .env.local / .env.prod；对应 yml：spring.profiles.active
SPRING_PROFILES_ACTIVE=prod
# HTTP API 端口；对应 yml：server.port
SERVER_PORT=8080

# ---------- JWT ----------
# 签名密钥 ≥32 字符；openssl rand -base64 32 或 PowerShell 生成
# 留空将导致启动校验失败
JWT_SECRET=
# access 有效期毫秒（本地 2h）；对应 yml：linkx.jwt.access-expire
JWT_ACCESS_EXPIRE=3600000
# refresh 有效期毫秒（7d）；对应 yml：linkx.jwt.refresh-expire
JWT_REFRESH_EXPIRE=604800000

# ---------- 消息落库加密 ----------
# 是否对 im_message.content / quote_content 落库 AES-256-GCM 加密
# 对应 yml：linkx.message-encryption.enabled
MESSAGE_CONTENT_ENCRYPT_ENABLED=true
# 主密钥（启用时必填，须独立于 JWT_SECRET）
# openssl rand -base64 32 或 ≥32 字符随机串
MESSAGE_KEK=
# 历史 KEK JSON（仅解密旧密文）
# 轮换示例：{"default":"旧KEK材料"}
MESSAGE_KEK_LEGACY_MAP=
# 密钥版本标识（轮换时改为新 id，如 v2）
MESSAGE_KEK_KEY_ID=default
# 加密开启时聊天记录搜索单次扫描条数上限
MESSAGE_SEARCH_SCAN_LIMIT=500
# 历史明文重加密每批条数（Snail Job message_content_reencrypt）
MESSAGE_REENCRYPT_BATCH_SIZE=500
# 密钥轮换重加密每批条数（Snail Job message_content_key_rotate）
MESSAGE_KEY_ROTATE_BATCH_SIZE=500

# ---------- MySQL ----------
# 完整 JDBC URL；对应 yml：spring.datasource.url
DB_URL=jdbc:mysql://YOUR_DB_HOST:3306/linkx?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=true&requireSSL=true
# 用户名；对应 yml：spring.datasource.username
DB_USERNAME=
# 密码；对应 yml：spring.datasource.password
DB_PASSWORD=

# ---------- Redis ----------
# 主机；对应 yml：spring.data.redis.host
REDIS_HOST=
# 端口；对应 yml：spring.data.redis.port
REDIS_PORT=6379
# 密码（无则留空）；对应 yml：spring.data.redis.password
REDIS_PASSWORD=
# DB 编号；对应 yml：spring.data.redis.database
REDIS_DATABASE=0
# 命令超时；对应 yml：spring.data.redis.timeout
REDIS_TIMEOUT=3s
# 连接超时；对应 yml：spring.data.redis.connect-timeout
REDIS_CONNECT_TIMEOUT=3s
# Lettuce 最大活跃连接；对应 yml：spring.data.redis.lettuce.pool.max-active
REDIS_LETTUCE_MAX_ACTIVE=32
# 最大空闲
REDIS_LETTUCE_MAX_IDLE=16
# 最小空闲
REDIS_LETTUCE_MIN_IDLE=4
# 获取连接最大等待
REDIS_LETTUCE_MAX_WAIT=3s

# ---------- HikariCP ----------
# 最大连接数；对应 yml：spring.datasource.hikari.maximum-pool-size
HIKARI_MAX_POOL_SIZE=30
# 最小空闲
HIKARI_MIN_IDLE=10
# 获取连接超时毫秒
HIKARI_CONNECTION_TIMEOUT=30000
# 空闲超时毫秒
HIKARI_IDLE_TIMEOUT=600000
# 连接最大存活毫秒
HIKARI_MAX_LIFETIME=1800000

# ---------- 上传体积 ----------
# 单文件上限；对应 yml：spring.servlet.multipart.max-file-size
# 本地安装包约 220MB，建议 300MB；生产可收紧
MULTIPART_MAX_FILE_SIZE=5MB
# 整次 multipart 请求上限
MULTIPART_MAX_REQUEST_SIZE=6MB
# Tomcat POST 体上限（与 multipart 不同层；默认仅 2MB）
# 对应 yml：server.tomcat.max-http-form-post-size
TOMCAT_MAX_HTTP_FORM_POST_SIZE=6MB
# Tomcat multipart part 数上限；-1 表示不限制
TOMCAT_MAX_PART_COUNT=-1
# Tomcat 吞掉超限请求；-1 表示不限制
TOMCAT_MAX_SWALLOW_SIZE=-1

# ---------- 鉴权 / 安全 ----------
# 客户端图形验证码；对应 yml：linkx.auth.captcha-enabled
CAPTCHA_ENABLED=true
# 管理端图形验证码；对应 yml：linkx.auth.admin-captcha-enabled（生产强制 true）
ADMIN_CAPTCHA_ENABLED=true
# 客户端验证码类型 image|slider
CLIENT_CAPTCHA_TYPE=image
# 管理端验证码类型 image|slider
ADMIN_CAPTCHA_TYPE=image
# 客户端开放注册；对应 yml：linkx.auth.register-enabled
REGISTER_ENABLED=true
# 忘记密码邮箱验证
FORGOT_PASSWORD_EMAIL_ENABLED=true
# 强制 HTTPS；对应 yml：linkx.security.require-https（生产强制 true）
REQUIRE_HTTPS=true
# 信任反代 X-Forwarded-*；对应 yml：linkx.proxy.trust-proxy
TRUST_PROXY=true
# 客户端登录失败锁定次数
AUTH_LOGIN_MAX_ATTEMPTS=3
# 管理端登录失败锁定次数
AUTH_ADMIN_LOGIN_MAX_ATTEMPTS=3
# 客户端锁定时长（分钟）
AUTH_LOCK_DURATION_MINUTES=10
# 管理端锁定时长（分钟）
AUTH_ADMIN_LOCK_DURATION_MINUTES=30
# 管理端强制 TOTP 2FA（生产强制 true）
ADMIN_TOTP_REQUIRED=true
# 密码最小长度
AUTH_PASSWORD_MIN_LENGTH=10
# 密码最大长度
AUTH_PASSWORD_MAX_LENGTH=64
# 是否必须同时包含大小写字母
AUTH_PASSWORD_REQUIRE_UPPER_LOWER=true
# 是否必须包含数字
AUTH_PASSWORD_REQUIRE_DIGIT=true
# 是否必须包含特殊字符
AUTH_PASSWORD_REQUIRE_SPECIAL=true
# 登录限流（次/分钟/IP）
AUTH_RATE_LIMIT_LOGIN=5
# 注册限流（次/分钟/IP）
AUTH_RATE_LIMIT_REGISTER=2

# ---------- CORS ----------
# 逗号分隔白名单；对应 yml：linkx.cors.allowed-origins
CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# ---------- IM ----------
# WebSocket 端口；对应 yml：linkx.im.websocket-port
IM_WS_PORT=8081

# ---------- MinIO ----------
# Endpoint；对应 yml：linkx.minio.endpoint
MINIO_ENDPOINT=https://minio.example.com
# Access Key；对应 yml：linkx.minio.access-key
MINIO_ACCESS_KEY=
# Secret Key；对应 yml：linkx.minio.secret-key
MINIO_SECRET_KEY=
# 桶名
MINIO_BUCKET_NAME=linkx
# 单文件字节上限；对应 yml：linkx.minio.max-file-size
MINIO_MAX_FILE_SIZE=5242880
# 头像预签名秒数
MINIO_PRESIGN_AVATAR_SECONDS=7200
# 文件预签名秒数
MINIO_PRESIGN_FILE_SECONDS=900
# 分享预签名秒数
MINIO_PRESIGN_SHARE_SECONDS=300

# ---------- 对象存储切换 ----------
# 当前提供商 minio|oss|local；管理端可热切换
STORAGE_PROVIDER=minio
# OSS Endpoint（如 oss-cn-beijing.aliyuncs.com）
OSS_ENDPOINT=
# OSS 桶名
OSS_BUCKET_NAME=
# OSS AccessKeyId
OSS_ACCESS_KEY_ID=
# OSS AccessKeySecret
OSS_ACCESS_KEY_SECRET=
# OSS 自定义 CNAME（可空）
OSS_CNAME_DOMAIN=
# 本地存储根目录（STORAGE_PROVIDER=local 时）
LOCAL_STORAGE_PATH=./data/local-storage

# ---------- 邮件 ----------
# SMTP 主机；对应 yml：linkx.mail.host
MAIL_HOST=smtp.qq.com
# SMTP 端口
MAIL_PORT=587
# 发信账号
MAIL_USERNAME=
# 授权码
MAIL_PASSWORD=
# 发件人地址
MAIL_FROM=
# 发件人显示名
MAIL_FROM_NAME=LinkX
# STARTTLS
MAIL_START_TLS=true
# SSL 直连（465 端口）
MAIL_SSL=false
# 验证码有效分钟
MAIL_CODE_EXPIRE_MINUTES=10

# ---------- 应用 / 留存 ----------
# 版本；对应 yml：linkx.app.version
APP_VERSION=1.0.0
# 发布渠道
APP_CHANNEL=stable
# 更新说明
APP_RELEASE_NOTES=
# 下载地址
APP_DOWNLOAD_URL=
# 有更新时是否强制升级
APP_FORCE_UPDATE=false
# 最低支持版本（低于则强更；可空）
APP_MIN_SUPPORTED_VERSION=
# 开发模式：允许 localhost 连 WS（生产必须 false）
DEV_MODE_ENABLED=false
# 消息保留天数；对应 yml：linkx.retention.message-days
MESSAGE_RETENTION_DAYS=365
# 可选：外部 ip2region.xdb 路径（可空，默认 classpath）
IP_GEO_XDB_PATH=

# ---------- Swagger / Actuator / 日志 ----------
# 是否开启 Swagger；对应 yml：springdoc.*.enabled
SPRINGDOC_ENABLED=false
# Actuator 暴露端点
MANAGEMENT_ENDPOINTS=health
# 健康详情策略
MANAGEMENT_HEALTH_SHOW_DETAILS=never
# 根日志级别
LOG_LEVEL_ROOT=INFO
# 业务包日志级别
LOG_LEVEL_LINKX=INFO
# Security 日志级别
LOG_LEVEL_SECURITY=WARN

# ---------- SnailJob 分布式调度 ----------
# 是否启用 SnailJob 客户端；对应 yml：snail-job.enabled
SNAIL_JOB_ENABLED=true
# 启动时注册内置任务；对应 yml：linkx.snail-job.sync-jobs-on-startup
SNAIL_JOB_SYNC_JOBS=true
# SnailJob gRPC 主机
SNAIL_JOB_SERVER_HOST=
# SnailJob gRPC 端口
SNAIL_JOB_SERVER_PORT=17888
# 控制台 Web 地址（管理端跳转）
SNAIL_JOB_ADMIN_URL=
# OpenAPI 主机
SNAIL_JOB_OPENAPI_HOST=
# OpenAPI 端口
SNAIL_JOB_OPENAPI_PORT=18080
# 命名空间（须在控制台创建）
SNAIL_JOB_NAMESPACE=
# 客户端组
SNAIL_JOB_GROUP=linkx_server
# 客户端 Token（须在控制台创建，禁止用仓库示例值上生产）
SNAIL_JOB_TOKEN=
# 客户端对外 host（多实例可留空）
SNAIL_JOB_CLIENT_HOST=
# 客户端端口
SNAIL_JOB_CLIENT_PORT=17889
