# =============================================================================
# 测试 profile 覆盖项（与 .env.local 合并：本文件优先）
# -----------------------------------------------------------------------------
# ⚠️ 安全警告：以下 MinIO 凭证为本机默认值，仅用于本地/CI 测试。
#    严禁复用到生产环境！生产 MinIO 必须使用独立高强度随机凭证。
#    生产凭证应通过 .env.prod（已 gitignore）或 K8s Secret/系统环境变量注入。
# =============================================================================

SPRING_PROFILES_ACTIVE=test

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=linkx-test
MINIO_MAX_FILE_SIZE=10485760
