# =============================================================================
# 测试 profile（.env.test）
# -----------------------------------------------------------------------------
# 与 .env.local 合并时：本文件优先覆盖同名键。
# CI 无 .env.local 时单独依赖本文件，须覆盖 application.yml 全部占位符。
# ⚠️ MinIO 等凭证仅用于本地/CI 测试，严禁用于生产。
# =============================================================================

SPRING_PROFILES_ACTIVE=test
SERVER_PORT=0

JWT_SECRET=Test-Local-JWT-Key-For-Integration-2026!!
JWT_ACCESS_EXPIRE=7200000
JWT_REFRESH_EXPIRE=604800000

# 主 yml 占位仍会解析；application-test.yml 会用 H2 覆盖 datasource
DB_URL=jdbc:h2:mem:linkx;MODE=MySQL;DB_CLOSE_DELAY=-1
DB_USERNAME=sa
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=3s
REDIS_CONNECT_TIMEOUT=3s
REDIS_LETTUCE_MAX_ACTIVE=8
REDIS_LETTUCE_MAX_IDLE=4
REDIS_LETTUCE_MIN_IDLE=1
REDIS_LETTUCE_MAX_WAIT=3s

HIKARI_MAX_POOL_SIZE=5
HIKARI_MIN_IDLE=1
HIKARI_CONNECTION_TIMEOUT=10000
HIKARI_IDLE_TIMEOUT=600000
HIKARI_MAX_LIFETIME=1800000

MULTIPART_MAX_FILE_SIZE=10MB
MULTIPART_MAX_REQUEST_SIZE=12MB

CAPTCHA_ENABLED=false
REQUIRE_HTTPS=false
TRUST_PROXY=false
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOCK_DURATION_MINUTES=15
AUTH_RATE_LIMIT_LOGIN=1000
AUTH_RATE_LIMIT_REGISTER=1000

CORS_ALLOWED_ORIGINS=http://localhost:5173

IM_WS_PORT=-1

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=linkx-test
MINIO_MAX_FILE_SIZE=10485760
MINIO_PRESIGN_AVATAR_SECONDS=7200
MINIO_PRESIGN_FILE_SECONDS=3600
MINIO_PRESIGN_SHARE_SECONDS=600

MAIL_HOST=localhost
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=test@linkx.com
MAIL_FROM_NAME=LinkX-Test
MAIL_START_TLS=false
MAIL_SSL=false
MAIL_CODE_EXPIRE_MINUTES=10

APP_VERSION=1.0.0-test
APP_CHANNEL=test
APP_RELEASE_NOTES=test
APP_DOWNLOAD_URL=
DEV_MODE_ENABLED=true
MESSAGE_RETENTION_DAYS=365

SPRINGDOC_ENABLED=false
MANAGEMENT_ENDPOINTS=health
MANAGEMENT_HEALTH_SHOW_DETAILS=never
LOG_LEVEL_ROOT=warn
LOG_LEVEL_LINKX=info
LOG_LEVEL_SECURITY=warn
