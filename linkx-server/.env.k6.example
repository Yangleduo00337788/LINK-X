# =============================================================================
# LinkX 后端 · k6 压测专用（.env.k6.example）
# -----------------------------------------------------------------------------
# 1. 复制为 .env.k6（已 gitignore）
# 2. 用 SPRING_PROFILES_ACTIVE=k6 启动后端，不要用正在跑的 local/prod 进程
# 3. 本文件会叠在 .env.local 之上：密钥/DB/MinIO 继承 local，这里只改压测差异
# 禁止把本文件的开关用于生产
# =============================================================================

SPRING_PROFILES_ACTIVE=k6

# 压测关图形验证码，避免登录被拦
CAPTCHA_ENABLED=false
ADMIN_CAPTCHA_ENABLED=false

# 关接口/登录/注册限流，避免大量 VU 打出 429
# 生产环境 ProductionSecurityValidator 会拒绝 RATE_LIMIT_ENABLED=false
RATE_LIMIT_ENABLED=false
AUTH_RATE_LIMIT_LOGIN=10000
AUTH_RATE_LIMIT_REGISTER=10000
AUTH_LOGIN_MAX_ATTEMPTS=10000
AUTH_LOCK_DURATION_MINUTES=1

# 与 local 隔离 Redis 会话/限流键，避免污染开发库 0
REDIS_DATABASE=15

# 仍走同一套 MySQL（复用已有压测账号）。若要库级隔离，改为 linkx_k6 并先建库
# DB_URL=jdbc:mysql://127.0.0.1:3306/linkx_k6?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false

# 压测连接池略放大
HIKARI_MAX_POOL_SIZE=40
HIKARI_MIN_IDLE=10
REDIS_LETTUCE_MAX_ACTIVE=32

# WS Origin 须与 k6/k6.env 的 K6_WS_ORIGIN 一致
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEV_MODE_ENABLED=true

# 压测不跑调度、不打外部 AI
SNAIL_JOB_ENABLED=false
LINKMATE_ENABLED=false

APP_RELEASE_NOTES=k6 压测构建
LOG_LEVEL_LINKX=info
