# =============================================================================
# 容器内应用专用环境模板（与宿主机 .env.local 区分）
# -----------------------------------------------------------------------------
# 复制为 .env.docker 后填写；compose --profile app 时使用。
# DB/Redis/MinIO 主机名使用 compose 服务名。
# =============================================================================

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
IM_WS_PORT=8081

JWT_SECRET=
JWT_ACCESS_EXPIRE=3600000
JWT_REFRESH_EXPIRE=604800000

DB_URL=jdbc:mysql://mysql:3306/linkx?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=linkx_app
DB_PASSWORD=

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=linkx
MINIO_MAX_FILE_SIZE=104857600
MINIO_PRESIGN_AVATAR_SECONDS=7200
MINIO_PRESIGN_FILE_SECONDS=3600
MINIO_PRESIGN_SHARE_SECONDS=600

MULTIPART_MAX_FILE_SIZE=100MB
MULTIPART_MAX_REQUEST_SIZE=110MB

CAPTCHA_ENABLED=true
REGISTER_ENABLED=true
FORGOT_PASSWORD_EMAIL_ENABLED=true
REQUIRE_HTTPS=false
TRUST_PROXY=true
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOCK_DURATION_MINUTES=10
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_PASSWORD_MAX_LENGTH=64
AUTH_PASSWORD_REQUIRE_UPPER_LOWER=false
AUTH_PASSWORD_REQUIRE_DIGIT=true
AUTH_PASSWORD_REQUIRE_SPECIAL=false
AUTH_RATE_LIMIT_LOGIN=10
AUTH_RATE_LIMIT_REGISTER=5

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=LinkX
MAIL_START_TLS=true
MAIL_SSL=false
MAIL_CODE_EXPIRE_MINUTES=10

APP_VERSION=1.0.0
APP_CHANNEL=stable
APP_RELEASE_NOTES=docker
APP_DOWNLOAD_URL=
# 开发模式（容器内关闭）；对应 yml：linkx.app.dev-mode-enabled
DEV_MODE_ENABLED=false
MESSAGE_RETENTION_DAYS=365

SPRINGDOC_ENABLED=false
MANAGEMENT_ENDPOINTS=health,info,metrics,prometheus
MANAGEMENT_HEALTH_SHOW_DETAILS=when_authorized
LOG_LEVEL_ROOT=info
LOG_LEVEL_LINKX=info
LOG_LEVEL_SECURITY=WARN

HIKARI_MAX_POOL_SIZE=20
HIKARI_MIN_IDLE=5
HIKARI_CONNECTION_TIMEOUT=30000
HIKARI_IDLE_TIMEOUT=600000
HIKARI_MAX_LIFETIME=1800000
REDIS_TIMEOUT=3s
REDIS_CONNECT_TIMEOUT=3s
REDIS_LETTUCE_MAX_ACTIVE=16
REDIS_LETTUCE_MAX_IDLE=8
REDIS_LETTUCE_MIN_IDLE=2
REDIS_LETTUCE_MAX_WAIT=3s

SNAIL_JOB_ENABLED=true
SNAIL_JOB_SYNC_JOBS=true
SNAIL_JOB_SERVER_HOST=snail-job
SNAIL_JOB_SERVER_PORT=17888
SNAIL_JOB_ADMIN_URL=http://127.0.0.1:18080
SNAIL_JOB_OPENAPI_HOST=snail-job
SNAIL_JOB_OPENAPI_PORT=8080
# 本地 compose 默认可与 snail-job 镜像初始化一致；生产务必在控制台重新生成
SNAIL_JOB_NAMESPACE=764d604ec6fc45f68cd92514c40e9e1a
SNAIL_JOB_GROUP=linkx_server
SNAIL_JOB_TOKEN=SJ_Wyz3dmsdbDOkDujOTSSoBjGQP1BMsVnj
SNAIL_JOB_CLIENT_HOST=
SNAIL_JOB_CLIENT_PORT=17889
