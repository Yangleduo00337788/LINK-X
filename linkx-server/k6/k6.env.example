# 复制为 k6.env 后填写（k6.env 已 gitignore，勿提交真实密码）
# 后端须用 SPRING_PROFILES_ACTIVE=k6（.env.k6）启动，不要打 local/prod
K6_BASE_URL=http://127.0.0.1:8080/api
K6_WS_URL=ws://127.0.0.1:8081/ws
# 必须在服务端 CORS_ALLOWED_ORIGINS 内，否则 WebSocket 握手会被拒绝
K6_WS_ORIGIN=http://127.0.0.1:5173
K6_USERNAME=k6_load_test
K6_PASSWORD=k6test123
# 可选：固定会话。不填则从 /chat/sessions 取第一条
# K6_CONVERSATION_ID=
# 社交套件（python prep-k6-social.py 会写入）
# K6_GROUP_ID=
# K6_CONFERENCE_ID=
# K6_MOMENTS_POST_ID=
# K6_CLOUD_FILE_ID=
# K6_CLOUD_FOLDER_ID=
# K6_NOTE_ID=
# K6_CALENDAR_EVENT_ID=
# K6_FAVORITE_ID=
# K6_SHORT_VIDEO_POST_ID=
# K6_STRANGER_USERNAME=k6_load_stranger
# K6_PEER_ID=9999999900003
# smoke | load | soak | stress
K6_PROFILE=load
# 覆盖档位，例如 K6_VUS=50 且 K6_DURATION=3m
# K6_VUS=
# K6_DURATION=
# 1 时 chat-ws 会真正发文本消息（写库）
# K6_WS_SEND=0
